---
# {{ ansible_managed }}
# Targets are generated from the Ansible inventory.
global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    lab: homelab

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]

  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]

  - job_name: grafana
    static_configs:
      - targets: ["grafana:3000"]

  - job_name: node
    static_configs:
{% for host in groups['homelab'] %}
      - targets: ["{{ hostvars[host]['ansible_host'] | default(host) }}:{{ hostvars[host]['monitoring_node_exporter_port'] | default(9100) }}"]
        labels:
          instance: {{ host }}
{% endfor %}
{% if groups['proxy'] | default([]) | length > 0 %}

  - job_name: traefik
    static_configs:
{% for host in groups['proxy'] %}
      - targets: ["{{ hostvars[host]['ansible_host'] | default(host) }}:{{ hostvars[host]['reverse_proxy_metrics_port'] | default(8082) }}"]
        labels:
          instance: {{ host }}
{% endfor %}
{% endif %}
