# {{ ansible_managed }}
[DEFAULT]
bantime  = {{ common_fail2ban_bantime }}
findtime = {{ common_fail2ban_findtime }}
maxretry = {{ common_fail2ban_maxretry }}
ignoreip = {{ common_fail2ban_ignoreip | join(' ') }}
# Bans go through ufw so they are visible in `ufw status`.
banaction = ufw

[sshd]
enabled = true
port    = {{ common_ssh_port }}
backend = systemd
