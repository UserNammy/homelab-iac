---
# {{ ansible_managed }}
{% if reverse_proxy_dashboard_enabled %}
http:
  routers:
    dashboard:
      rule: "Host(`{{ reverse_proxy_dashboard_host }}`)"
      entryPoints:
        - websecure
      service: api@internal
      middlewares:
        - lan-only
        - dashboard-auth
      tls:
        certResolver: letsencrypt
{% else %}
# Dashboard disabled.
{% endif %}
